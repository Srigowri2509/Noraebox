SUPABASE_URL=
SUPABASE_SERVICE_KEY=
DATABASE_URL=postgresql://user:password@host:5432/noraebox
PORT=8000
S3_BUCKET_NAME=noraebox-audio-storage
AWS_REGION=ap-south-2
S3_PUBLIC_BUCKET=true
CLOUDFRONT_URL=https://d1ccea5qf1wn0k.cloudfront.net

# Public URL of the website Node backend (not the React URL).
WEBSITE_API_URL=https://your-website-api.example.com
# Must equal TABLET_INTEGRATION_API_KEY in the website backend environment.
# This stays on AWS and must never be placed in tablet-app VITE variables.
WEBSITE_TABLET_API_KEY=replace_with_a_long_random_secret

# Inbound secret for the website backend's metadata-only AWS song catalogue calls.
# Must equal AWS_SONGS_API_KEY on the website backend. Never expose it in VITE variables.
WEBSITE_CATALOG_API_KEY=replace_with_a_different_long_random_secret
